# Leave empty when the frontend and backend share a domain. For separate hosting,
# set this to the public backend URL, for example https://api.example.com.
VITE_API_URL=
# Optional when the API is behind a proxy or hosted on a separate public domain.
PUBLIC_API_URL=
PORT=4000
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173
JWT_SECRET=change-this-secret
ADMIN_EMAIL=jsagricultureimportexportco@gmail.com
ADMIN_PASSWORD=Admin@123456

# Configure real SMTP below to enable password reset emails.
# Example for Gmail (use an App Password, not your normal password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=jsagricultureimportexportco@gmail.com
# SMTP_PASS=your-16-character-app-password
# SMTP_FROM=jsagricultureimportexportco@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=jsagricultureimportexportco@gmail.com
SMTP_PASS=
SMTP_FROM=jsagricultureimportexportco@gmail.com
