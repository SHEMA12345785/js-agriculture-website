# ---------------------------------------------------------------------------
# Backend configuration
# ---------------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0

# Public URL of the deployed site. Used to build password-reset links.
# Example: https://www.jsagricultureltd.com
CLIENT_URL=
PUBLIC_API_URL=

# Change this to a long random string before going live.
JWT_SECRET=change-this-to-a-long-random-secret

# Recipient for contact enquiries and admin password reset emails.
ADMIN_EMAIL=jsagricultureimportexportco@gmail.com
ADMIN_PASSWORD=Admin@123456

# ---------------------------------------------------------------------------
# Frontend API base (build-time)
# ---------------------------------------------------------------------------
# Leave EMPTY when the Express server serves the built site (recommended).
# Set it only when the frontend is hosted on a different domain than the API.
#
# NEVER set this to http://localhost:4000 for a deployed site. "localhost"
# means the visitor's own computer, so the site would only work on the machine
# running the backend.
#
# You can also change the backend URL after deployment by editing
# dist/config.js on the server - no rebuild required.
VITE_API_URL=

# ---------------------------------------------------------------------------
# Email (contact form + admin password reset)
# ---------------------------------------------------------------------------
# For Gmail: enable 2-Step Verification, then create an App Password.
# Do not use your normal Gmail password. Spaces in the app password are fine.
# Keep the real app password in the ignored local .env file; never commit it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=jsagricultureimportexportco@gmail.com
SMTP_PASS=
SMTP_FROM=jsagricultureimportexportco@gmail.com
